10 REM CIRCLES - THE NEAL-PITTEWAY MIDPOINT RECURRENCE
20 REM X=X-E/2*Y : Y=Y+E*X : X=X-E/2*Y - ONE STEP TURNS BY ABOUT E RADIANS
30 REM NO GRAPHICS HERE, SO THE POINTS GO INTO A CHARACTER GRID
40 REM ONLY A QUARTER TURN IS INTEGRATED - LINE 160 MIRRORS IT INTO THE REST
50 REM CX IS THE CENTRE COLUMN, CY THE ROW JUST BELOW THE CENTRE LINE
60 W=31:H=16:CX=16:CY=9
70 DIM G(31,16)
80 PRINT "CIRCLES"
90 FOR R=15 TO 5 STEP -5
100 E=1/R:X=R:Y=0
110 FOR A=1 TO 1.6*R+1
120 X=X-E/2*Y
130 Y=Y+E*X
140 X=X-E/2*Y
150 P=INT(CX+X+.5):Q=INT(CY+Y/2)
160 G(P,Q)=1:G(32-P,Q)=1:G(P,17-Q)=1:G(32-P,17-Q)=1
170 NEXT A
180 NEXT R
190 FOR Y=1 TO H
200 FOR X=1 TO W
210 IF G(X,Y)=1 THEN PRINT TAB(X);"*";
220 NEXT X
230 PRINT
240 NEXT Y
250 END
