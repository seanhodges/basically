10 REM CIRCLES - THE NEAL-PITTEWAY MIDPOINT RECURRENCE
20 REM X=X-E/2*Y : Y=Y+E*X : X=X-E/2*Y - ONE STEP TURNS BY ABOUT E RADIANS
30 REM NO GRAPHICS HERE, SO THE POINTS GO INTO A CHARACTER GRID
40 W=48:H=16
50 DIM G(48,16)
60 CX=24:CY=8:E=1/16
70 FOR R=3 TO 15 STEP 4
80 X=R:Y=0
90 FOR A=1 TO 110
100 X=X-E/2*Y
110 Y=Y+E*X
120 X=X-E/2*Y
130 PX=INT(CX+X+.5)
140 PY=INT(CY+Y/2+.5)
150 IF PX<1 OR PX>W OR PY<1 OR PY>H THEN 170
160 G(PX,PY)=1
170 NEXT A
180 NEXT R
190 PRINT
200 FOR Y=1 TO H
210 FOR X=1 TO W
220 C$=" "
230 IF G(X,Y)=1 THEN C$="*"
240 PRINT C$;
250 NEXT X
260 PRINT
270 NEXT Y
280 END
