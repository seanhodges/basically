10 REM BREAKOUT - 8K BASIC HAS NO INKEY$, SO ONE KEYSTROKE IS ONE FRAME
20 REM TYPE L, R OR S AND PRESS RETURN TO MOVE THE PADDLE AND STEP THE BALL
30 W=20:H=12:PW=4
40 DIM B(12,20)
50 NB=0
60 FOR Y=1 TO 2
70 FOR X=1 TO W
80 B(Y,X)=1:NB=NB+1
90 NEXT X
100 NEXT Y
110 PX=9:BX=10:BY=6:DX=1:DY=-1:S=0
120 REM ---- DRAW ONE WHOLE FRAME ----
130 PRINT
140 FOR Y=1 TO H
150 FOR X=1 TO W
160 C$=" "
170 IF B(Y,X)=1 THEN C$="="
180 IF Y=11 AND X>=PX AND X<PX+PW THEN C$="#"
190 IF X=BX AND Y=BY THEN C$="O"
200 PRINT C$;
210 NEXT X
220 PRINT
230 NEXT Y
240 PRINT "SCORE";S;" BRICKS";NB
250 INPUT "L,R OR S";M$
260 IF M$="L" AND PX>1 THEN PX=PX-1
270 IF M$="R" AND PX+PW<=W THEN PX=PX+1
280 NX=BX+DX:NY=BY+DY
290 IF NX<1 THEN DX=1:NX=BX+DX
300 IF NX>W THEN DX=-1:NX=BX+DX
310 IF NY<1 THEN DY=1:NY=BY+DY
320 IF B(NY,NX)=1 THEN B(NY,NX)=0:NB=NB-1:S=S+1:DY=1:NY=BY+DY
330 IF NY=11 AND NX>=PX AND NX<PX+PW THEN DY=-1:NY=BY+DY
340 BX=NX:BY=NY
350 IF BY>11 THEN 380
360 IF NB=0 THEN 400
370 GOTO 120
380 PRINT "GAME OVER - SCORE";S
390 END
400 PRINT "YOU CLEARED THE WALL - SCORE";S
410 END
