10 REM KALEIDOSCOPE - ONE QUARTER COMPUTED, MIRRORED INTO ALL FOUR
20 REM NO PLOTTING ON THIS MACHINE, SO THE PATTERN IS PRINTED AS CHARACTERS
30 W=16:H=6
40 DIM G(16,6)
50 FOR F=1 TO 3
60 P=(F-1)*1.5
70 FOR J=1 TO H
80 V=(H+.5-J)*2
90 FOR I=1 TO W
100 U=W+.5-I
110 D=SQR(U*U+V*V)
120 G(I,J)=1+INT(1.9*(1+SIN(D/2.2+P)))
130 NEXT I
140 NEXT J
150 PRINT
160 FOR J=1 TO H
170 GOSUB 240
180 NEXT J
190 FOR J=H TO 1 STEP -1
200 GOSUB 240
210 NEXT J
220 NEXT F
230 END
240 REM ---- ONE ROW, MIRRORED LEFT TO RIGHT ----
250 FOR I=1 TO W
260 GOSUB 330
270 NEXT I
280 FOR I=W TO 1 STEP -1
290 GOSUB 330
300 NEXT I
310 PRINT
320 RETURN
330 REM ---- ONE CELL ----
340 K=G(I,J)
350 C$=" "
360 IF K=2 THEN C$="."
370 IF K=3 THEN C$="*"
380 IF K=4 THEN C$="#"
390 PRINT C$;
400 RETURN
