10 REM BREAKOUT - A AND D MOVE THE PADDLE, SPACE SERVES
20 REM LO-RES, AND SCRN( READS A CELL BACK, SO THE SCREEN IS ALSO THE WALL
30 GR
40 FOR R = 0 TO 3
50 COLOR= R * 3 + 3
60 HLIN 0,39 AT R
70 NEXT R
80 S = 0
90 P = 17
100 COLOR= 15
110 HLIN P,P + 6 AT 38
120 GOSUB 750
130 VTAB 22
140 HTAB 1
150 PRINT "A AND D MOVE - SPACE TO SERVE";
160 K = PEEK ( - 16384)
170 IF K = 160 THEN 190
180 GOTO 160
190 POKE - 16368,0
200 VTAB 22
210 HTAB 1
220 PRINT "A AND D MOVE                 ";
230 B = 20
240 C = 36
250 D = 1
260 E = - 1
270 COLOR= 13
280 PLOT B,C
290 REM THE NEW CELL IS DRAWN BEFORE THE OLD ONE IS RUBBED OUT, SO THE BALL IS
300 REM NEVER OFF THE PAGE - AT THIS SPEED A GAP IN IT READS AS A FLICKER
310 GOSUB 630
320 IF B + D < 0 THEN D = 1
330 IF B + D > 39 THEN D = - 1
340 U = B + D
350 IF C + E < 0 THEN E = 1
360 V = C + E
370 IF V > 39 THEN 810
380 W = SCRN( U,V)
390 IF W = 0 THEN 480
400 IF W = 15 THEN 570
410 REM A BRICK: RUB IT OUT, SCORE IT, AND TURN THE BALL AROUND WHERE IT STANDS
420 COLOR= 0
430 PLOT U,V
440 S = S + 1
450 GOSUB 750
460 E = - E
470 GOTO 310
480 COLOR= 13
490 PLOT U,V
500 COLOR= 0
510 PLOT B,C
520 B = U
530 C = V
540 IF S = 160 THEN 850
550 GOTO 310
560 REM THE PADDLE: WHICH HALF THE BALL LANDS ON DECIDES WHICH WAY IT LEAVES
570 E = - 1
580 D = - 1
590 IF U > P + 3 THEN D = 1
600 GOTO 310
610 REM THE PADDLE, REDRAWN ONLY WHEN A KEY IS WAITING AT THE LATCH. THE LATCH
620 REM CARRIES BIT 7 AND ASC DOES NOT, SO THE CODES ARE COMPARED PLUS 128
630 K = PEEK ( - 16384)
640 IF K < 128 THEN 740
650 POKE - 16368,0
660 IF K = ASC ("A") + 128 THEN P = P - 2
670 IF K = ASC ("D") + 128 THEN P = P + 2
680 IF P < 0 THEN P = 0
690 IF P > 33 THEN P = 33
700 COLOR= 0
710 HLIN 0,39 AT 38
720 COLOR= 15
730 HLIN P,P + 6 AT 38
740 RETURN
750 REM THE SCOREBOARD, IN THE FOUR TEXT LINES BELOW THE LO-RES PAGE. CHR$(7)
760 REM IS THE SPEAKER: THERE IS NO SOUND STATEMENT, ONLY THE MONITOR'S BELL
770 VTAB 21
780 HTAB 1
790 PRINT "SCORE ";S;"  ";CHR$ (7);
800 RETURN
810 VTAB 22
820 HTAB 1
830 PRINT "GAME OVER                    ";
840 END
850 VTAB 22
860 HTAB 1
870 PRINT "YOU CLEARED THE WALL         ";
880 END
