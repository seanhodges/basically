10 REM Concentric circles in Mode 0 - Locomotive graphics
20 MODE 0
30 FOR I=0 TO 15:INK I,I:NEXT
40 BORDER 0
50 XC=320:YC=200
60 E=1/40
70 FOR R=1 TO 15
80 RAD=R*13
90 X=RAD:Y=0
100 PLOT XC+X,YC+Y,R
110 FOR A=1 TO 130
120 X=X-E*Y:Y=Y+E*X:X=X-E*Y
130 DRAW XC+X,YC+Y,R
140 NEXT A
150 NEXT R
160 LOCATE 1,25:PEN 15:PRINT "Concentric circles";
170 GOTO 170
