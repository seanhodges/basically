10 REM Hello - Amstrad CPC 464 welcome
20 MODE 0:BORDER 0
30 FOR I=0 TO 15:INK I,I:NEXT
40 INK 0,0:INK 15,26,6
50 S=0:CLS
60 S=S+1
70 FOR R=1 TO 13
80 PEN 1+((R+S) MOD 13)
90 LOCATE 6+(R MOD 5),R+1:PRINT "HELLO!"
100 NEXT
110 PEN 14:LOCATE 6,16:PRINT "CPC 464"
120 PEN 15:LOCATE 5,20:PRINT "BASICALLY"
130 FOR T=1 TO 300:NEXT
140 GOTO 60
