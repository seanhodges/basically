10 REM Breakout - move the bat with the cursor left/right keys
20 MODE 1:INK 0,0:INK 1,24:INK 2,6:INK 3,9:BORDER 0:PEN 1
30 DIM BR(40,6)
40 SC=0:NB=0
50 FOR R=2 TO 5:FOR C=4 TO 37
60 BR(C,R)=1:NB=NB+1
70 PEN 2:LOCATE C,R:PRINT CHR$(143);
80 NEXT:NEXT
90 PX=18:BX=20:BY=20:DX=1:DY=-1
100 PEN 3:GOSUB 500
110 REM --- main loop ---
120 PEN 1:LOCATE BX,BY:PRINT " ";
130 OP=PX
140 IF INKEY(8)<>-1 AND PX>1 THEN PX=PX-1
150 IF INKEY(1)<>-1 AND PX<37 THEN PX=PX+1
160 IF PX<>OP THEN LOCATE OP,25:PRINT "    ";:PEN 3:GOSUB 500
170 NX=BX+DX:NY=BY+DY
180 IF NX<1 THEN NX=1:DX=1
190 IF NX>40 THEN NX=40:DX=-1
200 IF NY<1 THEN NY=1:DY=1
210 IF BR(NX,NY)=1 THEN BR(NX,NY)=0:NB=NB-1:SC=SC+10:PEN 1:LOCATE NX,NY:PRINT " ";:DY=-DY:NY=BY:GOTO 240
220 IF NY=24 AND NX>=PX AND NX<=PX+3 THEN DY=-1:NY=23
230 IF NY>25 THEN 300
240 BX=NX:BY=NY
250 PEN 1:LOCATE BX,BY:PRINT "O";
260 IF NB=0 THEN LOCATE 16,13:PEN 2:PRINT "YOU WIN!":GOTO 280
270 FOR T=1 TO 30:NEXT:GOTO 120
280 GOTO 280
300 LOCATE 13,13:PEN 2:PRINT "GAME OVER   SCORE";SC
310 GOTO 310
500 LOCATE PX,25:PRINT CHR$(143);CHR$(143);CHR$(143);CHR$(143);:RETURN
