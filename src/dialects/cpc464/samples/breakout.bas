10 REM Breakout - clear the bricks with the bat
20 MODE 1:INK 0,0:INK 1,24:INK 2,6:INK 3,9:BORDER 0
30 PEN 1:LOCATE 14,2:PRINT "B R E A K O U T"
40 PEN 2:LOCATE 8,8:PRINT "1. KEYBOARD (CURSOR KEYS)"
50 PEN 3:LOCATE 8,10:PRINT "2. JOYSTICK"
60 MD=1
70 A$=INKEY$:IF A$="" THEN 70
80 IF A$="2" THEN MD=2
90 PEN 1:LOCATE 7,14:PRINT "PRESS SPACE / FIRE TO START"
100 IF MD=1 AND INKEY(47)=-1 THEN 100
110 IF MD=2 AND (JOY(0) AND 48)=0 THEN 110
120 CLS
130 DIM BR(40,7)
140 SC=0:NB=0
150 FOR R=3 TO 6:FOR C=4 TO 37
160 BR(C,R)=1:NB=NB+1
170 PEN 2:LOCATE C,R:PRINT CHR$(143);
180 NEXT:NEXT
190 PEN 3:LOCATE 1,1:IF MD=1 THEN PRINT "CURSOR KEYS TO MOVE";
200 IF MD=2 THEN LOCATE 1,1:PRINT "JOYSTICK TO MOVE";
210 PX=18:BX=20:BY=20:DX=1:DY=-1
220 PEN 3:GOSUB 800
230 REM --- main loop ---
240 PEN 1:LOCATE BX,BY:PRINT " ";
250 OP=PX
260 LF=0:RT=0
270 IF MD=1 AND INKEY(8)<>-1 THEN LF=1
280 IF MD=1 AND INKEY(1)<>-1 THEN RT=1
290 IF MD=2 AND (JOY(0) AND 4)<>0 THEN LF=1
300 IF MD=2 AND (JOY(0) AND 8)<>0 THEN RT=1
310 IF LF AND PX>1 THEN PX=PX-1
320 IF RT AND PX<37 THEN PX=PX+1
330 IF PX<>OP THEN LOCATE OP,25:PRINT "    ";:PEN 3:GOSUB 800
340 NX=BX+DX:NY=BY+DY
350 IF NX<1 THEN NX=1:DX=1
360 IF NX>40 THEN NX=40:DX=-1
370 IF NY<1 THEN NY=1:DY=1
380 IF NY<3 OR NY>6 THEN 400
390 IF BR(NX,NY)=1 THEN BR(NX,NY)=0:NB=NB-1:SC=SC+10:PEN 1:LOCATE NX,NY:PRINT " ";:DY=-DY:NY=BY:SOUND 1,80,3:GOTO 420
400 IF NY=24 AND NX>=PX AND NX<=PX+3 THEN DY=-1:NY=23:SOUND 1,150,3
410 IF NY>25 THEN 600
420 BX=NX:BY=NY
430 PEN 1:LOCATE BX,BY:PRINT "O";
440 IF NB=0 THEN 500
450 FOR T=1 TO 30:NEXT:GOTO 240
500 LOCATE 16,13:PEN 2:PRINT "YOU WIN!"
510 SOUND 1,239,20:SOUND 1,190,20:SOUND 1,159,40
520 GOTO 520
600 LOCATE 13,13:PEN 2:PRINT "GAME OVER   SCORE";SC
610 SOUND 1,300,20:SOUND 1,379,20:SOUND 1,451,40
620 GOTO 620
800 LOCATE PX,25:PRINT CHR$(143);CHR$(143);CHR$(143);CHR$(143);:RETURN
