10 REM Maze - walk to the E with the cursor keys
20 MODE 1:INK 0,0:INK 1,24:INK 2,6:INK 3,9:BORDER 0:PEN 1
30 DIM M$(11)
40 FOR R=1 TO 11:READ M$(R):NEXT
50 PEN 2
60 FOR R=1 TO 11:LOCATE 8,R+3:PRINT M$(R);:NEXT
70 PX=2:PY=2
80 PEN 3:LOCATE 7+PX,3+PY:PRINT "@";
90 IF INKEY(0)<>-1 THEN NX=PX:NY=PY-1:GOSUB 200
100 IF INKEY(2)<>-1 THEN NX=PX:NY=PY+1:GOSUB 200
110 IF INKEY(8)<>-1 THEN NX=PX-1:NY=PY:GOSUB 200
120 IF INKEY(1)<>-1 THEN NX=PX+1:NY=PY:GOSUB 200
130 FOR T=1 TO 60:NEXT
140 GOTO 90
200 IF NX<1 OR NX>14 OR NY<1 OR NY>11 THEN RETURN
210 C$=MID$(M$(NY),NX,1)
220 IF C$="#" THEN RETURN
230 PEN 3:LOCATE 7+PX,3+PY:PRINT " ";
240 PX=NX:PY=NY
250 LOCATE 7+PX,3+PY:PRINT "@";
260 IF C$="E" THEN LOCATE 13,17:PEN 2:PRINT "YOU ESCAPED!":GOTO 280
270 RETURN
280 GOTO 280
