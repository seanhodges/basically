10 REM NEAL-PITTEWAY CIRCLES - MODE 2 16 COLOURS
20 REM X=X-E/2*Y: Y=Y+E*X: X=X-E/2*Y
30 MODE 2
40 CX=640:CY=512
50 E=1/16
60 FOR R=120 TO 480 STEP 120
70 GCOL 0,(R/120) MOD 16
80 X=R:Y=0
90 MOVE CX+X,CY+Y
100 FOR A=1 TO 105
110 X=X-E/2*Y
120 Y=Y+E*X
130 X=X-E/2*Y
140 DRAW CX+X,CY+Y
150 NEXT
160 NEXT
170 Z%=INKEY(1000)
180 GOTO 30
