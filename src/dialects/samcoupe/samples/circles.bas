10 REM NEAL-PITTEWAY CIRCLES - MODE 3, THE SAM'S 512-PIXEL SCREEN
20 REM X=X-E/2*Y: Y=Y+E*X: X=X-E/2*Y
30 MODE 3: CSIZE 8,9: BORDER 0: PAPER 0: PEN 3: CLS
40 LET E=1/24: LET XC=256: LET YC=87
50 FOR R=24 TO 72 STEP 24
60 PEN R/24
70 LET X=R: LET Y=0
80 LET PX=XC+R: LET PY=YC: PLOT PX,PY
90 FOR A=1 TO 155
100 LET X=X-E/2*Y
110 LET Y=Y+E*X
120 LET X=X-E/2*Y
130 LET NX=XC+INT (X): LET NY=YC+INT (Y)
140 DRAW NX-PX,NY-PY
150 LET PX=NX: LET PY=NY
160 NEXT A
170 NEXT R
180 PEN 3: PRINT AT 18,23;"CONCENTRIC CIRCLES"
190 PAUSE 0
