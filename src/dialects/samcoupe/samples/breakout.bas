10 REM BREAKOUT - CLEAR THE BRICKS WITH THE BAT
20 MODE 4: BORDER 0: PAPER 0: CLS
30 PEN 15: PRINT AT 6,8;"B R E A K O U T"
40 PEN 6: PRINT AT 10,3;"KEYS 6 AND 7 MOVE"
50 PEN 4: PRINT AT 11,2;"SO DOES THE JOYSTICK"
60 PEN 15: PRINT AT 14,3;"PRESS 0 OR FIRE"
70 DO
80 LOOP UNTIL INKEY$="0"
90 CLS
100 DIM B(32,6)
110 LET SC=0: LET NB=0
120 FOR R=3 TO 6
130 FOR C=2 TO 29
140 LET B(C+1,R)=1: LET NB=NB+1
150 PEN 1+((C+R) MOD 6)
160 PRINT AT R,C;"█"
170 NEXT C
180 NEXT R
190 PEN 15: PRINT AT 0,0;"SCORE ";SC
200 LET PX=14: LET BX=16: LET BY=16: LET DX=1: LET DY=-1
210 PEN 5: PRINT AT 18,PX;"████"
220 DO
230 PRINT AT BY,BX;" "
240 LET K$=INKEY$
250 LET OP=PX
260 IF K$="6" AND PX>0 THEN LET PX=PX-1
270 IF K$="7" AND PX<28 THEN LET PX=PX+1
280 IF PX<>OP
290 PRINT AT 18,OP;"    "
300 PEN 5: PRINT AT 18,PX;"████"
310 END IF
320 LET NX=BX+DX: LET NY=BY+DY
330 IF NX<0 THEN LET NX=0: LET DX=1
340 IF NX>31 THEN LET NX=31: LET DX=-1
350 IF NY<1 THEN LET NY=1: LET DY=1
360 IF NY>=3 AND NY<=6
370 IF B(NX+1,NY)=1
380 LET B(NX+1,NY)=0: LET NB=NB-1: LET SC=SC+10
390 PRINT AT NY,NX;" "
400 PEN 15: PRINT AT 0,0;"SCORE ";SC
410 LET DY=-DY: LET NY=BY
420 ZAP
430 END IF
440 END IF
450 IF NY=17 AND NX>=PX AND NX<=PX+3
460 LET DY=-1: LET NY=16
470 POW
480 END IF
490 EXIT IF NY>18
500 LET BX=NX: LET BY=NY
510 PEN 15: PRINT AT BY,BX;"O"
520 EXIT IF NB=0
530 LOOP
540 IF NB=0
550 PEN 4: PRINT AT 10,11;"YOU WIN!"
560 ZOOM
570 ELSE
580 PEN 2: PRINT AT 10,10;"GAME OVER"
590 BOOM
600 END IF
610 PAUSE 0
