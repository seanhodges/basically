10 REM CIRCLES - PETSCII PLOTTING
20 REM THE VIC-20 HAS NO BITMAP, SO WE
30 REM POKE THE 22X23 SCREEN AT 7680 AND
40 REM ITS COLOUR RAM AT 38400 DIRECTLY.
50 POKE 36879,8:PRINT CHR$(147)
60 SC=7680:CO=30720
70 CX=11:CY=11
80 FOR R=2 TO 8 STEP 2
90 FOR A=0 TO 6.3 STEP .1
100 X=CX+R*COS(A):Y=CY+R*.8*SIN(A)
110 IX=INT(X+.5):IY=INT(Y+.5)
120 IF IX<0 OR IX>21 OR IY<0 OR IY>22 THEN 150
130 P=SC+22*IY+IX
140 POKE P,81:POKE P+CO,R/2
150 NEXT A
160 NEXT R
170 PRINT CHR$(19);"PRESS A KEY"
180 GET K$:IF K$="" THEN 180
190 POKE 36879,27:PRINT CHR$(147)
