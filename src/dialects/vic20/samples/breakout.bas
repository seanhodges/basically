10 REM BREAKOUT
20 POKE 36879,8:PRINT CHR$(147)
30 SC=7680:CO=30720
40 PRINT CHR$(5);"   * BREAKOUT *"
50 PRINT:PRINT " A AND D TO MOVE"
60 PRINT:PRINT " PRESS SPACE"
70 GET K$:IF K$<>" " THEN 70
80 PRINT CHR$(147)
90 NB=0:PR=22:PX=9
100 FOR R=2 TO 4
110 FOR C=2 TO 19
120 P=SC+22*R+C:POKE P,160:POKE P+CO,R
130 NB=NB+1
140 NEXT C:NEXT R
150 GOSUB 500
160 BX=11:BY=12:VX=1:VY=-1:S=0
170 GET K$
180 IF K$="A" AND PX>0 THEN GOSUB 520:PX=PX-1:GOSUB 500
190 IF K$="D" AND PX<18 THEN GOSUB 520:PX=PX+1:GOSUB 500
200 POKE SC+22*BY+BX,32
210 NX=BX+VX:NY=BY+VY
220 IF NX<0 OR NX>21 THEN VX=-VX:NX=BX+VX
230 IF NY<1 THEN VY=-VY:NY=BY+VY
240 IF NY=PR-1 AND NX>=PX AND NX<=PX+3 THEN VY=-VY:NY=BY+VY
250 PT=SC+22*NY+NX
260 IF PEEK(PT)=160 THEN POKE PT,32:NB=NB-1:S=S+1:VY=-VY:NY=BY+VY
270 BX=NX:BY=NY
280 POKE SC+22*BY+BX,81:POKE SC+22*BY+BX+CO,1
290 FOR T=1 TO 40:NEXT
300 IF BY>=22 THEN 330
310 IF NB>0 THEN 170
320 PRINT CHR$(147);"YOU WIN  SCORE ";S:END
330 PRINT CHR$(147);"GAME OVER  SCORE ";S:END
490 REM DRAW PADDLE
500 FOR I=0 TO 3:POKE SC+22*PR+PX+I,160:POKE SC+22*PR+PX+I+CO,6:NEXT:RETURN
515 REM ERASE PADDLE
520 FOR I=0 TO 3:POKE SC+22*PR+PX+I,32:NEXT:RETURN
