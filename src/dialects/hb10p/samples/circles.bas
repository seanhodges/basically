10 REM NEAL-PITTEWAY CONCENTRIC CIRCLES - SCREEN 2
20 REM X=X-E/2*Y:Y=Y+E*X:X=X-E/2*Y, WITH H HOLDING E/2
30 DEFSNG A-Z:SCREEN 2:COLOR 15,1,1:CLS
40 FOR R=1 TO 4
50 D=R*20:C=R+3
60 REM ---- N STEPS OF E RADIANS CLOSE THE RING, SO E IS SET FROM N ----
70 N=16+32*R:E=6.2832/N:H=E/2
80 X=D:Y=0
90 PSET(128+X,96+Y),C
100 FOR A=1 TO N
110 X=X-H*Y
120 Y=Y+E*X
130 X=X-H*Y
140 LINE -(128+X,96+Y),C
150 NEXT A
160 NEXT R
170 IF INKEY$="" THEN 170
180 GOTO 30
