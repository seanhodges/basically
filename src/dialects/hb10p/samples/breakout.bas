10 REM BREAKOUT - CLEAR THE BRICKS WITH THE BAT
20 DEFINT A-Z:SCREEN 1:WIDTH 32:KEY OFF:COLOR 15,4,4:CLS
30 LOCATE 8,2:PRINT "B R E A K O U T"
40 LOCATE 3,8:PRINT "1. KEYBOARD (CURSOR KEYS)"
50 LOCATE 3,10:PRINT "2. JOYSTICK"
60 M=1
70 K$=INKEY$:IF K$="" THEN 70
80 IF K$="2" THEN M=2
90 LOCATE 2,14:PRINT "PRESS SPACE / FIRE TO START"
100 IF STRIG(M-1)=0 THEN 100
110 CLS:VPOKE &H2000+27,&HA4
120 DIM W(31,7)
130 S=0:N=0:G=&H1800:E=G+704
140 FOR J=3 TO 6:FOR I=2 TO 29
150 W(I,J)=1:N=N+1:VPOKE G+J*32+I,219
160 NEXT I:NEXT J
170 LOCATE 0,0:PRINT "SCORE";S
180 IF M=1 THEN LOCATE 18,0:PRINT "CURSOR KEYS";
190 IF M=2 THEN LOCATE 18,0:PRINT "JOYSTICK   ";
200 P=14:X=16:Y=18:U=1:V=-1
210 GOSUB 800
220 REM ---- MAIN LOOP ----
230 D=STICK(M-1)
240 IF (D=7 OR D=6 OR D=8) AND P>0 THEN VPOKE E+P+3,32:P=P-1:VPOKE E+P,219
250 IF (D=3 OR D=2 OR D=4) AND P<28 THEN VPOKE E+P,32:P=P+1:VPOKE E+P+3,219
260 A=X+U:B=Y+V
270 IF A<0 THEN A=0:U=1
280 IF A>31 THEN A=31:U=-1
290 IF B<1 THEN B=1:V=1
300 IF B<3 OR B>6 THEN 340
310 IF W(A,B)=0 THEN 340
320 W(A,B)=0:N=N-1:S=S+10:VPOKE G+B*32+A,32:V=-V:B=Y:PLAY"V15O6C64"
330 LOCATE 0,0:PRINT "SCORE";S
340 IF B=22 AND A>=P AND A<=P+3 THEN V=-1:B=21:PLAY"V15O4G64"
350 IF B>22 THEN 600
360 VPOKE G+Y*32+X,32:X=A:Y=B
370 VPOKE G+Y*32+X,79
380 IF N=0 THEN 500
390 GOTO 230
500 LOCATE 12,12:PRINT "YOU WIN!"
510 PLAY"V15O5CEGO6C"
520 GOTO 520
600 LOCATE 11,12:PRINT "GAME OVER"
610 PLAY"V15O4GEDC"
620 GOTO 620
800 FOR I=0 TO 3:VPOKE E+P+I,219:NEXT I:RETURN
