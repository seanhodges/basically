10 REM NEAL-PITTEWAY CIRCLES - INTEGER FIXED-POINT
20 REM SCALE 256; E=1/16 SO E*X=X/16, E/2*Y=Y/32 (/ IS INTEGER DIVIDE)
30 CLEAR 4
40 FOR R=20 TO 80 STEP 20
50 X=R*256
60 Y=0
70 J=128+R
80 K=96
90 FOR N=1 TO 105
100 X=X-Y/32
110 Y=Y+X/16
120 X=X-Y/32
130 G=128+X/256
140 H=96+Y/256
150 MOVE J,K
160 DRAW G,H
170 J=G
180 K=H
190 NEXT N
200 NEXT R
210 END
