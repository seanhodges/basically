10 REM DATA FILES - WRITE THEN READ BACK
20 REM BYTES GO TO THE EMULATOR FILES VIEWER (TOOLBAR)
30 F=FOUT"SQUARES"
40 FOR N=1 TO 5
50 BPUT F,N*N
60 NEXT N
70 PRINT "WROTE 5 SQUARES TO ""SQUARES"""'
80 G=FIN"SQUARES"
90 FOR N=1 TO 5
100 PRINT "SQUARE "N" = "BGET G'
110 NEXT N
120 PRINT '"DONE"'
130 END
