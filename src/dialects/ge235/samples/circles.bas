10 REM CIRCLES - THREE RINGS FROM THE PITTEWAY RECURRENCE
20 REM X=X-E/2*Y, THEN Y=Y+E*X, THEN X=X-E/2*Y AGAIN
30 REM A QUARTER TURN AND A LITTLE MORE, MIRRORED INTO THE OTHER THREE
40 DIM G(14,30)
50 PRINT "CIRCLES"
60 FOR R=4 TO 14 STEP 5
70 LET E=1/R
80 LET X=R
90 LET Y=0
100 FOR A=1 TO 1.75*R
110 LET C=INT(X+.5)
120 LET D=INT(Y/2+.5)
130 LET G(7-D,15-C)=1
140 LET G(7-D,15+C)=1
150 LET G(7+D,15-C)=1
160 LET G(7+D,15+C)=1
170 LET X=X-E/2*Y
180 LET Y=Y+E*X
190 LET X=X-E/2*Y
200 NEXT A
210 NEXT R
220 FOR I=0 TO 14
230 FOR J=0 TO 30
240 IF G(I,J)=1 THEN 270
250 PRINT " ";
260 GOTO 280
270 PRINT "*";
280 NEXT J
290 PRINT
300 NEXT I
310 END
