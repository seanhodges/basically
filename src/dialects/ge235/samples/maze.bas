10 REM MAZE - REACH E
20 REM A 13 BY 9 MAP IS 117 CONSTANTS AND THE DATA POOL HOLDS 128
30 DIM M(8,12)
40 FOR I=0 TO 8
50 FOR J=0 TO 12
60 READ M(I,J)
70 NEXT J
80 NEXT I
90 LET Y=1
100 LET X=1
110 GOSUB 370
120 PRINT "REACH E. 1 UP 2 DOWN 3 LEFT 4 RIGHT"
130 INPUT D
140 LET P=Y
150 LET Q=X
160 IF D=1 THEN 210
170 IF D=2 THEN 230
180 IF D=3 THEN 250
190 IF D=4 THEN 270
200 GOTO 120
210 LET P=Y-1
220 GOTO 280
230 LET P=Y+1
240 GOTO 280
250 LET Q=X-1
260 GOTO 280
270 LET Q=X+1
280 IF M(P,Q)=1 THEN 120
290 LET Y=P
300 LET X=Q
310 IF M(Y,X)=2 THEN 340
320 GOSUB 370
330 GOTO 120
340 GOSUB 370
350 PRINT "YOU ESCAPED."
360 STOP
370 REM THE WHOLE MAP AGAIN: A TELETYPE CANNOT GO BACK FOR ONE CELL
380 PRINT
390 FOR I=0 TO 8
400 FOR J=0 TO 12
410 IF I<>Y THEN 430
420 IF J=X THEN 470
430 IF M(I,J)=1 THEN 490
440 IF M(I,J)=2 THEN 510
450 PRINT " ";
460 GOTO 520
470 PRINT "O";
480 GOTO 520
490 PRINT "*";
500 GOTO 520
510 PRINT "E";
520 NEXT J
530 PRINT
540 NEXT I
550 RETURN
