10 REM BREAKOUT
20 PRINT CHR$(147)
30 SC=32768
40 PRINT "       *** BREAKOUT ***"
50 PRINT:PRINT "   A AND D TO MOVE THE PADDLE"
60 PRINT:PRINT "   PRESS SPACE TO START"
70 GET K$:IF K$<>" " THEN 70
80 PRINT CHR$(147)
90 NB=0:PR=24:PX=18
100 FOR R=2 TO 4
110 FOR C=5 TO 34
120 POKE SC+40*R+C,160:NB=NB+1
130 NEXT C:NEXT R
140 GOSUB 500
150 BX=20:BY=12:VX=1:VY=-1:S=0
160 GET K$
170 IF K$="A" AND PX>0 THEN GOSUB 520:PX=PX-2:GOSUB 500
180 IF K$="D" AND PX<35 THEN GOSUB 520:PX=PX+2:GOSUB 500
190 POKE SC+40*BY+BX,32
200 NX=BX+VX:NY=BY+VY
210 IF NX<0 OR NX>39 THEN VX=-VX:NX=BX+VX
220 IF NY<1 THEN VY=-VY:NY=BY+VY
230 IF NY=PR-1 AND NX>=PX AND NX<=PX+4 THEN VY=-VY:NY=BY+VY
240 PT=SC+40*NY+NX
250 IF PEEK(PT)=160 THEN POKE PT,32:NB=NB-1:S=S+1:VY=-VY:NY=BY+VY
260 BX=NX:BY=NY
270 POKE SC+40*BY+BX,81
280 FOR T=1 TO 40:NEXT
290 IF BY>=24 THEN 320
300 IF NB>0 THEN 160
310 PRINT CHR$(147);"YOU WIN  SCORE ";S:END
320 PRINT CHR$(147);"GAME OVER  SCORE ";S:END
490 REM DRAW PADDLE
500 FOR I=0 TO 4:POKE SC+40*PR+PX+I,160:NEXT:RETURN
515 REM ERASE PADDLE
520 FOR I=0 TO 4:POKE SC+40*PR+PX+I,32:NEXT:RETURN
