10 REM CIRCLES - PETSCII CHARACTER PLOTTING
20 REM THE PET HAS NO BITMAP, SO WE POKE THE
30 REM 40X25 SCREEN RAM AT 32768 DIRECTLY.
40 PRINT CHR$(147)
50 SC=32768
60 CX=20:CY=12
70 FOR R=3 TO 11 STEP 2
80 FOR A=0 TO 6.3 STEP .1
90 X=CX+R*COS(A):Y=CY+R*.6*SIN(A)
100 IX=INT(X+.5):IY=INT(Y+.5)
110 IF IX<0 OR IX>39 OR IY<0 OR IY>24 THEN 130
120 POKE SC+40*IY+IX,81
130 NEXT A
140 NEXT R
150 PRINT CHR$(19);"PRESS A KEY"
160 GET K$:IF K$="" THEN 160
170 PRINT CHR$(147)
