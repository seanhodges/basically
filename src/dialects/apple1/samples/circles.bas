10 REM CIRCLES - THE NEAL-PITTEWAY MIDPOINT INTEGRATOR
20 REM X=X-E/2*Y : Y=Y+E*X : X=X-E/2*Y, E=1/16, EVERYTHING SCALED BY 1024
30 REM ONE TURN IS 2*PI/E STEPS: S RUNS TO 104 OR EACH RING IS AN OPEN ARC
40 REM THE POINTS GO INTO A 21 BY 19 GRID IN THE FREE RAM BELOW LOMEM
50 B=768
60 FOR I=0 TO 398
70 POKE B+I,0
80 NEXT I
90 FOR K=1 TO 3
100 X=K*3072
110 Y=0
120 FOR S=1 TO 104
130 X=X-Y/32
140 Y=Y+X/16
150 X=X-Y/32
160 V=11+(Y+512*SGN(Y))/1024
170 REM A CELL IS 7 DOTS WIDE AND 8 TALL, SO 1024*7/8 IS THE 896 HERE
180 W=20+(X+448*SGN(X))/896
190 POKE B+(V-2)*21+W-10,1
200 NEXT S
210 NEXT K
220 FOR R=2 TO 20
230 TAB 10
240 FOR C=10 TO 30
250 IF PEEK(B+(R-2)*21+C-10)=1 THEN 280
260 PRINT " ";
270 GOTO 290
280 PRINT "*";
290 NEXT C
300 PRINT
310 NEXT R
320 END
