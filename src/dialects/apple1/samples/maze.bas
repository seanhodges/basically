10 REM MAZE - TYPE W A S OR D AND RETURN. REACH THE E.
20 REM NO CURSOR ADDRESSING, SO THE WHOLE MAP IS PRINTED AGAIN EACH MOVE
30 DIM M$(171),K$(4)
40 M$="###################"
50 M$(20)="# # #             #"
60 M$(39)="# # # ####### #####"
70 M$(58)="# #         #     #"
80 M$(77)="# ########### ### #"
90 M$(96)="# #     #   # #   #"
100 M$(115)="# # ### # # ### # #"
110 M$(134)="#   #     #     #E#"
120 M$(153)="###################"
130 X=2
140 Y=2
150 PRINT "REACH E - W A S D TO MOVE"
160 REM THE MARKER IS ONE POSITION IN THE MAP STRING, NOT A SECOND GRID
170 Z=(Y-1)*19+X
180 P=0
190 FOR R=1 TO 9
200 FOR C=1 TO 19
210 P=P+1
220 IF P=Z THEN 250
230 PRINT M$(P,P);
240 GOTO 260
250 PRINT "O";
260 NEXT C
270 PRINT
280 NEXT R
290 INPUT "W,A,S OR D",K$
300 V=X
310 U=Y
320 IF K$="W" THEN U=Y-1
330 IF K$="A" THEN V=X-1
340 IF K$="D" THEN V=X+1
350 IF K$="S" THEN U=Y+1
360 IF V<>X THEN 390
370 IF U<>Y THEN 390
380 GOTO 290
390 P=(U-1)*19+V
400 IF M$(P,P)="#" THEN 290
410 X=V
420 Y=U
430 IF M$(P,P)="E" THEN 450
440 GOTO 170
450 PRINT
460 PRINT "YOU ESCAPED!"
470 END
