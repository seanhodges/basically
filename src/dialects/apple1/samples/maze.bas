10 REM MAZE - TYPE I J K OR M AND RETURN. REACH THE E.
20 REM ANY KEYPRESS STOPS A RUNNING PROGRAM HERE, SO INPUT IS THE ONLY
30 REM KEY READ THERE IS. AND WITH NO CURSOR ADDRESSING THE WHOLE MAP
40 REM IS PRINTED AGAIN AFTER EVERY MOVE, THE SCROLL CARRYING IT UP.
70 DIM M$(171),K$(4)
80 M$="###################"
90 M$(20)="# # #             #"
100 M$(39)="# # # ####### #####"
110 M$(58)="# #         #     #"
120 M$(77)="# ########### ### #"
130 M$(96)="# #     #   # #   #"
140 M$(115)="# # ### # # ### # #"
150 M$(134)="#   #     #     #E#"
160 M$(153)="###################"
170 X=2
180 Y=2
190 PRINT "I UP  J LEFT  K RIGHT  M DOWN"
200 REM THE MARKER IS ONE POSITION IN THE MAP STRING, SO A CELL COSTS
210 REM ONE COMPARISON RATHER THAN TWO.
220 Z=(Y-1)*19+X
230 P=0
240 FOR R=1 TO 9
250 FOR C=1 TO 19
260 P=P+1
270 IF P=Z THEN 300
280 PRINT M$(P,P);
290 GOTO 310
300 PRINT "*";
310 NEXT C
320 PRINT
330 NEXT R
340 INPUT "MOVE",K$
350 A=X
360 B=Y
370 IF K$="I" THEN B=Y-1
380 IF K$="J" THEN A=X-1
390 IF K$="K" THEN A=X+1
400 IF K$="M" THEN B=Y+1
410 IF A<>X THEN 440
420 IF B<>Y THEN 440
430 GOTO 340
440 P=(B-1)*19+A
450 IF M$(P,P)="#" THEN 340
460 X=A
470 Y=B
480 IF M$(P,P)="E" THEN 510
490 GOTO 220
510 PRINT
520 PRINT "YOU ESCAPED!"
530 END
