10 REM NEAL-PITTEWAY CIRCLES - BLOCK GRAPHICS ON THE 128X48 GRID
20 CLS
30 CX=64:CY=24
40 E=1/24
50 FOR R=6 TO 22 STEP 4
60 X=R:Y=0
70 FOR A=1 TO 155
80 X=X-E/2*Y
90 Y=Y+E*X
100 X=X-E/2*Y
110 PX=CX+X:PY=CY+Y*.6
120 IF PX<0 OR PX>127 OR PY<0 OR PY>47 THEN 140
130 SET(PX,PY)
140 NEXT A
150 NEXT R
160 END
