10 REM NEAL-PITTEWAY CIRCLES - HI-RES BITMAP
20 REM X=X-E/2*Y: Y=Y+E*X: X=X-E/2*Y
30 POKE 53280,0
40 POKE 53272,PEEK(53272) OR 8
50 POKE 53265,PEEK(53265) OR 32
60 FOR I=1024 TO 2023:POKE I,224:NEXT
70 FOR I=8192 TO 16191:POKE I,0:NEXT
80 DIM BT(7):FOR K=0 TO 7:READ BT(K):NEXT
90 DATA 128,64,32,16,8,4,2,1
100 CX=160:CY=100:E=1/48
110 FOR R=20 TO 80 STEP 20
120 X=R:Y=0
130 FOR A=1 TO 310
140 X=X-E/2*Y
150 Y=Y+E*X
160 X=X-E/2*Y
170 PX=CX+X:PY=CY+Y
180 GOSUB 230
190 NEXT A
200 NEXT R
210 GET K$:IF K$="" THEN 210
220 POKE 53265,PEEK(53265) AND 223:POKE 53272,21:PRINT CHR$(147):END
230 IX=INT(PX+.5):IY=INT(PY+.5)
240 IF IX<0 OR IX>319 OR IY<0 OR IY>199 THEN RETURN
250 BA=8192+INT(IY/8)*320+(IX AND 504)+(IY AND 7)
260 POKE BA,PEEK(BA) OR BT(IX AND 7)
270 RETURN
