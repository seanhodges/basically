10 REM NEAL-PITTEWAY CIRCLES - PETSCII COLOUR
20 POKE 53280,0:POKE 53281,0
25 REM X=X-E/2*Y: Y=Y+E*X: X=X-E/2*Y
30 PRINT CHR$(147)
40 SC=1024:CM=55296:CO=CM-SC
50 CX=20:CY=12
60 E=1/16:CL=1
70 FOR R=3 TO 12 STEP 3
80 X=R:Y=0
90 FOR A=1 TO 105
100 X=X-E/2*Y
110 Y=Y+E*X
120 X=X-E/2*Y
130 PX=CX+X:PY=CY+Y
140 IF PX<0 OR PX>39 OR PY<0 OR PY>24 THEN 170
150 P=SC+40*INT(PY+.5)+INT(PX+.5)
160 POKE P,81:POKE P+CO,CL
170 NEXT A
180 CL=CL+1:IF CL>15 THEN CL=1
190 NEXT R
200 FOR T=1 TO 2000:NEXT
210 GOTO 30
