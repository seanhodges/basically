10 REM NEAL-PITTEWAY CIRCLES - GRAPHICS 8
20 REM X=X-E/2*Y: Y=Y+E*X: X=X-E/2*Y
30 GRAPHICS 8+16:SETCOLOR 2,8,2:SETCOLOR 1,8,14:COLOR 1
40 CX=160:CY=96:E=1/16
50 FOR R=20 TO 80 STEP 30
60 X=R:Y=0
70 PLOT CX+X,CY
80 FOR A=1 TO 105
90 X=X-E/2*Y
100 Y=Y+E*X
110 X=X-E/2*Y
120 DRAWTO CX+X,CY+Y
130 NEXT A
140 NEXT R
150 POKE 764,255
160 IF PEEK(764)=255 THEN 160
170 GRAPHICS 0
