10 REM BREAKOUT
20 GRAPHICS 0:POKE 752,1:POKE 82,0
30 SETCOLOR 2,0,0:SETCOLOR 4,0,0:SETCOLOR 1,0,14
40 PRINT "{clear}";
50 POSITION 12,2:PRINT "*** BREAKOUT ***"
60 POSITION 10,5:PRINT "1. KEYBOARD"
70 POSITION 10,7:PRINT "2. JOYSTICK (PORT 1)"
80 GOSUB 900
90 MD=1
100 POKE 764,255
110 IF PEEK(764)=255 THEN 110
120 IF PEEK(764)=30 THEN MD=2
130 POSITION 10,10
140 IF MD=1 THEN PRINT "PRESS SPACE TO START"
150 IF MD=2 THEN PRINT "PRESS FIRE TO START"
160 POKE 764,255
170 IF MD=1 AND PEEK(764)<>33 THEN 170
180 IF MD=2 AND STRIG(0)=1 THEN 180
190 POKE 764,255
200 PRINT "{clear}";
210 NB=0:PR=18:PX=18:S=0:HU=0
220 FOR R=3 TO 5
230 FOR C=5 TO 34
240 IF C+2*R-4*INT((C+2*R)/4)=0 THEN 260
250 POSITION C,R:PRINT "{$a0}";:NB=NB+1
260 NEXT C
270 NEXT R
280 POSITION 0,0:PRINT "SCORE 0";
290 IF MD=1 THEN POSITION 14,0:PRINT "A D TO MOVE";
295 IF MD=2 THEN POSITION 14,0:PRINT "JOYSTICK PORT 1";
300 GOSUB 700
310 BX=20:BY=12:VX=1:VY=-1
320 GOSUB 600
330 IF LF=1 AND PX>0 THEN GOSUB 720:PX=PX-2:GOSUB 700
340 IF RT=1 AND PX<34 THEN GOSUB 720:PX=PX+2:GOSUB 700
350 POSITION BX,BY:PRINT " ";
360 NX=BX+VX:NY=BY+VY
370 IF NX<0 OR NX>38 THEN VX=-VX:NX=BX+VX:GOSUB 800
380 IF NY<1 THEN VY=-VY:NY=BY+VY:GOSUB 800
390 IF NY=PR-1 AND NX>=PX AND NX<=PX+4 THEN VY=-VY:NY=BY+VY:GOSUB 800
400 LOCATE NX,NY,T
410 IF T=160 THEN GOSUB 850
420 BX=NX:BY=NY
430 POSITION BX,BY:PRINT "{$14}";
440 FOR D=1 TO 25:NEXT D
450 IF BY>=PR THEN 500
460 IF NB>0 THEN 320
470 POSITION 0,21:PRINT "YOU WIN  SCORE ";S;
480 POKE 752,0:END
500 POSITION 0,21:PRINT "GAME OVER  SCORE ";S;
510 GOSUB 950
520 POKE 752,0:END
600 REM READ INPUT
610 LF=0:RT=0
620 IF MD=2 THEN 660
630 K=PEEK(764)
640 IF K=63 THEN LF=1
650 IF K=58 THEN RT=1
655 POKE 764,255:RETURN
660 J=STICK(0)
670 IF J=11 THEN LF=1
680 IF J=7 THEN RT=1
690 RETURN
700 REM DRAW PADDLE
710 POSITION PX,PR:PRINT "{$a0}{$a0}{$a0}{$a0}{$a0}";:RETURN
720 REM ERASE PADDLE
730 POSITION PX,PR:PRINT "     ";:RETURN
800 REM BOUNCE
810 SOUND 0,121,10,8:FOR D=1 TO 3:NEXT D:SOUND 0,0,0,0:RETURN
850 REM BRICK
860 POSITION NX,NY:PRINT " ";
870 NB=NB-1:S=S+1:VY=-VY:NY=BY+VY
880 HU=HU+2:IF HU>14 THEN HU=0
885 SETCOLOR 2,HU,2
890 SOUND 0,40,10,8:FOR D=1 TO 3:NEXT D:SOUND 0,0,0,0
895 POSITION 6,0:PRINT S;:RETURN
900 REM TITLE TUNE
910 SOUND 0,121,10,8:FOR D=1 TO 40:NEXT D
920 SOUND 0,96,10,8:FOR D=1 TO 40:NEXT D
930 SOUND 0,81,10,8:FOR D=1 TO 40:NEXT D
940 SOUND 0,72,10,8:FOR D=1 TO 60:NEXT D:SOUND 0,0,0,0:RETURN
950 REM GAME OVER SLIDE
960 FOR P=60 TO 200 STEP 4
970 SOUND 0,P,10,8:FOR D=1 TO 3:NEXT D
980 NEXT P
990 SOUND 0,0,0,0:RETURN
