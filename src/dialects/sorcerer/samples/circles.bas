10 REM NEAL-PITTEWAY CIRCLES - PLOTTED IN GRAPHICS CHARACTERS
20 REM X=X-E/2*Y : Y=Y+E*X : X=X-E/2*Y TURNS (X,Y) BY E RADIANS
30 REM A QUARTER TURN IS INTEGRATED AND MIRRORED INTO THE OTHER THREE
40 PRINT CHR$(12);
50 SC=-3968:CX=32:CY=15:E=1/13
60 FOR R=4 TO 12 STEP 4
70 X=R:Y=0
80 FOR A=1 TO 23
90 U=INT(X+.5):V=INT(Y+.5)
100 POKE SC+(CY+V)*64+CX+U,132
110 POKE SC+(CY+V)*64+CX-U,132
120 POKE SC+(CY-V)*64+CX+U,132
130 POKE SC+(CY-V)*64+CX-U,132
140 X=X-E/2*Y
150 Y=Y+E*X
160 X=X-E/2*Y
170 NEXT A
180 NEXT R
190 END
