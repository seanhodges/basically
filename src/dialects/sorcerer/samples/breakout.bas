10 REM BREAKOUT - A MOVES THE PADDLE LEFT, S MOVES IT RIGHT
20 REM USR(0) SCANS THE KEYS INTO 28672, SEE KEYS.ASM
30 POKE 260,1:POKE 261,112
40 PRINT CHR$(12);
50 PRINT "BREAKOUT"
60 PRINT
70 PRINT "A MOVES LEFT   S MOVES RIGHT"
80 PRINT "PRESS SPACE TO START"
90 A=USR(0):IF (PEEK(28672)AND 16)=0 THEN 90
100 PRINT CHR$(12);
110 PRINT "SCORE 000";
120 SC=-3968:NB=0
130 FOR R=3 TO 5
140 FOR C=4 TO 55 STEP 4
150 POKE SC+R*64+C,177:POKE SC+R*64+C+1,177:POKE SC+R*64+C+2,177
160 NB=NB+1
170 NEXT C
180 NEXT R
190 REM ---- THE BALL AND PADDLE ARE HELD AS SCREEN ADDRESSES, SO THE
200 REM ---- LOOP BELOW ADDS AND NEVER MULTIPLIES. IT IS TWICE AS QUICK
210 PX=29:PA=SC+1728+PX:BX=32:BY=24:DX=1:DY=-1:S=0
220 BA=SC+BY*64+BX:DA=DX+64*DY
230 FOR I=0 TO 6:POKE PA+I,169:NEXT I
240 A=USR(0):K=PEEK(28672)
250 IF (K AND 4) AND PX>1 THEN POKE PA+5,32:POKE PA+6,32:PX=PX-2:PA=PA-2:POKE PA,169:POKE PA+1,169
260 IF (K AND 8) AND PX<55 THEN POKE PA,32:POKE PA+1,32:PX=PX+2:PA=PA+2:POKE PA+5,169:POKE PA+6,169
270 POKE BA,32
280 NX=BX+DX:NY=BY+DY:NA=BA+DA
290 IF NX<0 OR NX>63 THEN DX=-DX:DA=DX+64*DY:NX=BX+DX:NA=BA+DA
300 IF NY<1 THEN DY=-DY:DA=DX+64*DY:NY=BY+DY:NA=BA+DA
310 IF NY=27 AND NX>=PX AND NX<=PX+6 THEN DY=-DY:DA=DX+64*DY:NY=BY+DY:NA=BA+DA
320 IF PEEK(NA)=177 THEN GOSUB 400
330 BX=NX:BY=NY:BA=NA
340 POKE BA,132
350 IF BY>28 THEN 370
360 IF NB>0 THEN 240
370 IF NB=0 THEN 390
380 PRINT CHR$(12);:PRINT "GAME OVER   SCORE";S:END
390 PRINT CHR$(12);:PRINT "YOU WIN   SCORE";S:END
400 REM ---- KNOCK OUT THE BRICK THE BALL HIT
410 BC=INT((NX-4)/4)*4+4
420 BB=NA-NX+BC
430 POKE BB,32:POKE BB+1,32:POKE BB+2,32
440 NB=NB-1:S=S+1:DY=-DY:DA=DX+64*DY:NY=BY+DY:NA=BA+DA
450 POKE SC+6,48+INT(S/100)
460 POKE SC+7,48+INT(S/10)-10*INT(S/100)
470 POKE SC+8,48+S-10*INT(S/10)
480 RETURN
