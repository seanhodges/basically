10 REM CIRCLES - THREE RINGS FROM THE PITTEWAY RECURRENCE
20 REM X=X-E/2*Y, THEN Y=Y+E*X, THEN X=X-E/2*Y AGAIN
30 REM A QUARTER TURN AND A LITTLE MORE, MIRRORED INTO THE OTHER THREE
40 REM THE GRID HOLDS CHARACTER CODES, SO A ROW PRINTS AS ONE STRING
50 DIM G(19,35)
60 DIM C(35)
70 MAT G = CON
80 MAT G = (32)*G
90 PRINT "CIRCLES"
100 FOR R = 5 TO 17 STEP 6
110 LET E = 1/R
120 LET X = R
130 LET Y = 0
140 FOR A = 1 TO 1.75*R
150 LET C = INT(X+.5)
160 LET D = INT(Y/2+.5)
170 LET G(10-D,18-C) = 42
180 LET G(10-D,18+C) = 42
190 LET G(10+D,18-C) = 42
200 LET G(10+D,18+C) = 42
210 LET X = X-E/2*Y
220 LET Y = Y+E*X
230 LET X = X-E/2*Y
240 NEXT A
250 NEXT R
260 LET C(0) = 35
270 FOR I = 1 TO 19
280 FOR J = 1 TO 35
290 LET C(J) = G(I,J)
300 NEXT J
310 CHANGE C TO B$
320 PRINT B$
330 NEXT I
340 END
