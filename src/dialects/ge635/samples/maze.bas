10 REM MAZE - REACH E
20 REM THE MAP IS STRING DATA, AND CHANGE IS THE ONLY WAY INSIDE A STRING
30 DIM M$(11)
40 DIM C(30)
50 FOR I = 1 TO 11
60 READ M$(I)
70 NEXT I
80 LET Y = 2
90 LET X = 2
100 GOSUB 420
110 PRINT "REACH E. W UP S DOWN A LEFT D RIGHT"
120 INPUT A$
130 LET P = Y
140 LET Q = X
150 IF A$ = "W" THEN 220
160 IF A$ = "S" THEN 240
170 IF A$ = "A" THEN 260
180 IF A$ = "D" THEN 280
190 GOTO 110
200 REM THE FOUR MOVES, EACH OF ONE CELL
210 REM A WALL IS CODE 35, THE EXIT 69, THE MARKER 79
220 LET P = Y-1
230 GOTO 290
240 LET P = Y+1
250 GOTO 290
260 LET Q = X-1
270 GOTO 290
280 LET Q = X+1
290 LET B$ = M$(P)
300 CHANGE B$ TO C
310 IF C(Q) = 35 THEN 110
320 LET Y = P
330 LET X = Q
340 LET Z = C(Q)
350 GOSUB 420
360 IF Z = 69 THEN 380
370 GOTO 110
380 PRINT "YOU ESCAPED!"
390 STOP
400 REM THE WHOLE MAP AGAIN: A TELETYPE CANNOT GO BACK FOR ONE CELL
410 REM ONE ROW CARRIES THE MARKER, AND IT IS THE ONLY ONE TAKEN APART
420 PRINT
430 FOR I = 1 TO 11
440 IF I = Y THEN 470
450 PRINT M$(I)
460 GOTO 520
470 LET B$ = M$(I)
480 CHANGE B$ TO C
490 LET C(X) = 79
500 CHANGE C TO B$
510 PRINT B$
520 NEXT I
530 RETURN
540 DATA "#####################"
550 DATA "#       #       #   #"
560 DATA "####### # # ### # # #"
570 DATA "#     # # #   # # # #"
580 DATA "##### # ### # # # # #"
590 DATA "#   # #   # # # # # #"
600 DATA "# # # ### ### # # ###"
610 DATA "# #     #     # #   #"
620 DATA "# ############# ### #"
630 DATA "#                  E#"
640 DATA "#####################"
650 END
