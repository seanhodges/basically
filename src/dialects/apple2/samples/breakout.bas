10 REM BREAKOUT - A AND D MOVE THE PADDLE, SPACE SERVES
20 REM LO-RES, AND SCRN READS A CELL BACK, SO THE SCREEN IS ALSO THE BRICK WALL
30 GR
40 CALL -936
50 FOR R=0 TO 3
60 COLOR=R*3+3
70 HLIN 0,39 AT R
80 NEXT R
90 S=0
100 P=17
110 COLOR=15
120 HLIN P,P+6 AT 38
130 GOSUB 750
140 VTAB 22
150 TAB 1
160 PRINT "A AND D MOVE - SPACE TO SERVE";
170 K=PEEK(-16384)
180 IF K<>ASC(" ") THEN 170
190 POKE -16368,0
200 VTAB 22
210 TAB 1
220 PRINT "A AND D MOVE                 ";
230 BX=20
240 BY=36
250 DX=1
260 DY=-1
270 COLOR=13
280 PLOT BX,BY
290 REM THE NEW CELL IS DRAWN BEFORE THE OLD ONE IS RUBBED OUT, SO THE BALL IS
300 REM NEVER OFF THE PAGE - AT THIS SPEED A GAP IN IT READS AS A FLICKER
310 GOSUB 620
320 IF BX+DX<0 THEN DX=1
330 IF BX+DX>39 THEN DX=-1
340 NX=BX+DX
350 IF BY+DY<0 THEN DY=1
360 NY=BY+DY
370 IF NY>39 THEN 790
380 C=SCRN(NX,NY)
390 IF C=0 THEN 480
400 IF C=15 THEN 560
410 REM A BRICK: RUB IT OUT, SCORE IT, AND TURN THE BALL AROUND WHERE IT STANDS
420 COLOR=0
430 PLOT NX,NY
440 S=S+1
450 GOSUB 750
460 DY=-DY
470 GOTO 310
480 COLOR=13
490 PLOT NX,NY
500 COLOR=0
510 PLOT BX,BY
520 BX=NX
530 BY=NY
540 IF S=160 THEN 830
550 GOTO 310
560 REM THE PADDLE: WHICH HALF THE BALL LANDS ON DECIDES WHICH WAY IT LEAVES
570 DY=-1
580 DX=-1
590 IF NX>P+3 THEN DX=1
600 GOTO 310
610 REM THE PADDLE, REDRAWN ONLY WHEN A KEY IS WAITING AT THE LATCH
620 K=PEEK(-16384)
630 IF K<128 THEN 730
640 POKE -16368,0
650 IF K=ASC("A") THEN P=P-2
660 IF K=ASC("D") THEN P=P+2
670 IF P<0 THEN P=0
680 IF P>33 THEN P=33
690 COLOR=0
700 HLIN 0,39 AT 38
710 COLOR=15
720 HLIN P,P+6 AT 38
730 RETURN
740 REM THE SCOREBOARD, IN THE FOUR TEXT LINES BELOW THE LO-RES PAGE
750 VTAB 21
760 TAB 1
770 PRINT "SCORE ";S;"  ";
780 RETURN
790 VTAB 22
800 TAB 1
810 PRINT "GAME OVER                    ";
820 END
830 VTAB 22
840 TAB 1
850 PRINT "YOU CLEARED THE WALL         ";
860 END
