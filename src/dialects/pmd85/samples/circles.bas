10 REM NEAL-PITTEWAY CONCENTRIC CIRCLES, DRAWN WITH PLOT
20 REM X=X-E/2*Y : Y=Y+E*X : X=X-E/2*Y
30 GCLEAR
40 SCALE -128,128,-128,128
50 E=1/40
60 FOR R=1 TO 5
70 RD=R*24
80 X=RD
90 Y=0
100 MOVE X,Y
110 REM ---- 260 STEPS OF E RADIANS CLOSES THE RING ----
120 FOR A=1 TO 260
130 X=X-E/2*Y
140 Y=Y+E*X
150 X=X-E/2*Y
160 PLOT X,Y
170 NEXT A
180 NEXT R
190 IF INKEY=255 THEN 190
200 GOTO 30
