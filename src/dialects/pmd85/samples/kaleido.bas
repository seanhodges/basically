10 REM KALEIDOSCOPE - MACHINE CODE DRAWS, BASIC ASKS
20 GCLEAR
30 PRINT
40 PRINT TAB(14);"K A L E I D O S C O P E"
50 PRINT
60 REM ---- INPUT TAKES NO PROMPT STRING HERE, SO THE PROMPT IS PRINTED ----
70 PRINT "SEED (0-255)";
80 INPUT S
90 PRINT "TWIST (0-255)";
100 INPUT T
110 PRINT "PASSES (1-9)";
120 INPUT P
130 GCLEAR
140 REM ---- THE THREE PARAMETERS SIT AT THE FOOT OF THE BLOCK ----
150 POKE '7000,S
160 POKE '7001,T
170 POKE '7002,P
180 A=USR('7003)
190 IF INKEY=255 THEN 190
200 IF INKEY<255 THEN 200
210 GOTO 20
