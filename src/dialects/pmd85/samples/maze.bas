10 REM MAZE - K0 UP, K1 LEFT, K2 RIGHT, K3 DOWN. REACH THE E.
20 DIM M$(12)
30 FOR I=0 TO 12
40 READ M$(I)
50 NEXT I
60 REM ---- THE MAP IS DRAWN ONCE. AFTER THIS ONLY THE MARKER CELL CHANGES, ----
70 REM ---- SO A MOVE COSTS SIXTEEN POKES INSTEAD OF A WHOLE SCREEN. ----
80 GCLEAR
90 PRINT "K0 UP   K1 LEFT   K2 RIGHT   K3 DOWN"
100 PRINT
110 FOR I=0 TO 12
120 PRINT M$(I)
130 NEXT I
140 PRINT
150 PRINT "REACH THE E TO ESCAPE"
160 X=1
170 Y=1
180 B=63
190 GOSUB 610
200 REM ---- INKEY SEES ONLY THE FUNCTION KEYS, AND THAT IS ENOUGH ----
210 K=INKEY
220 IF K=255 THEN 210
230 NX=X
240 NY=Y
250 IF K=1 THEN NX=X-1
260 IF K=2 THEN NX=X+1
270 IF K=0 THEN NY=Y-1
280 IF K=3 THEN NY=Y+1
290 IF NX<0 THEN 380
300 IF NX>38 THEN 380
310 IF NY<0 THEN 380
320 IF NY>12 THEN 380
330 T$=MID$(M$(NY),NX+1,1)
340 IF T$="#" THEN 380
350 GOTO 400
360 REM
370 REM ---- BLOCKED: LET THE KEY COME UP, THEN ASK AGAIN ----
380 IF INKEY<255 THEN 380
390 GOTO 210
400 REM ---- ERASE THE CELL BEING LEFT, STEP, DRAW THE CELL ARRIVED AT ----
410 B=0
420 GOSUB 610
430 X=NX
440 Y=NY
450 B=63
460 GOSUB 610
470 BEEP
480 IF T$="E" THEN 520
490 IF INKEY<255 THEN 490
500 GOTO 210
510 REM ---- REACHED THE EXIT ----
520 GCLEAR
530 PRINT
540 PRINT "YOU ESCAPED!"
550 BEEP
560 END
570 REM ---- THE MARKER IS ONE CHARACTER CELL: SIX PIXELS WIDE, EIGHT ----
580 REM ---- SCANLINES TALL, AND A SCANLINE IS 64 BYTES FROM THE NEXT. THE ----
590 REM ---- FIRST PRINT AFTER GCLEAR LANDS ON TEXT ROW 1, SO MAP ROW Y IS ----
600 REM ---- ROW 3+Y, WHOSE TOP SCANLINE IS 28+9*Y. ----
610 A='C000+64*(28+9*Y)+X
620 FOR J=0 TO 7
630 POKE A+64*J,B
640 NEXT J
650 RETURN
