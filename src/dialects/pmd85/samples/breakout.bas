10 REM BREAKOUT - K0 LEFT, K1 RIGHT. THE SCREEN IS POKED, NOT PRINTED.
20 GCLEAR
30 PRINT
40 PRINT TAB(16);"B R E A K O U T"
50 PRINT
60 PRINT TAB(9);"K0 MOVES LEFT, K1 MOVES RIGHT"
70 PRINT TAB(9);"PRESS ANY FUNCTION KEY TO START"
80 IF INKEY=255 THEN 80
90 GCLEAR
100 REM ---- VIDEO RAM IS 'C000 + 64*SCANLINE + COLUMN, SIX PIXELS TO A BYTE ----
110 V='C000
120 DIM B(15)
130 N=16
140 S=0
150 FOR I=0 TO 15
160 B(I)=1
170 GOSUB 800
180 NEXT I
190 PC=21
200 BC=24
210 BL=120
220 DC=1
230 DL=-4
240 GOSUB 920
250 GOSUB 700
260 REM ---- ONE FRAME: READ THE PADDLE KEYS, THEN STEP THE BALL ----
270 K=INKEY
280 IF K>1 THEN 340
290 GOSUB 970
300 IF K=0 THEN PC=PC-2
310 IF K=1 THEN PC=PC+2
320 IF PC<0 THEN PC=0
330 IF PC>41 THEN PC=41
340 GOSUB 920
350 GOSUB 750
360 NC=BC+DC
370 NL=BL+DL
380 IF NC<0 THEN DC=1
390 IF NC>47 THEN DC=-1
400 IF NC<0 THEN NC=0
410 IF NC>47 THEN NC=47
420 IF NL<8 THEN DL=4
430 IF NL<8 THEN NL=8
440 IF NL<32 THEN GOSUB 1020
450 IF NL<224 THEN 490
460 IF NC<PC THEN 490
470 IF NC>PC+5 THEN 490
480 DL=-4
490 BC=NC
500 BL=NL
510 GOSUB 700
520 IF N=0 THEN 560
530 IF BL<232 THEN 270
540 REM ---- OVER, ONE WAY OR THE OTHER ----
550 REM
560 GCLEAR
570 PRINT
580 PRINT "SCORE";S
590 IF N=0 THEN PRINT "YOU CLEARED THE WALL!"
600 IF N>0 THEN PRINT "BALL LOST."
610 BEEP
620 END
630 REM
640 REM
650 REM
660 REM
670 REM
680 REM
690 REM ---- DRAW THE BALL ----
700 A=V+64*BL+BC
710 POKE A,63
720 POKE A+64,63
730 RETURN
740 REM ---- ERASE THE BALL ----
750 A=V+64*BL+BC
760 POKE A,0
770 POKE A+64,0
780 RETURN
790 REM ---- DRAW BRICK I: THREE COLUMNS ON SCANLINES 24 TO 26 ----
800 A=V+64*24+I*3
810 POKE A,63,63,62
820 POKE A+64,63,63,62
830 POKE A+128,63,63,62
840 RETURN
850 REM ---- ERASE BRICK I ----
860 A=V+64*24+I*3
870 POKE A,0,0,0
880 POKE A+64,0,0,0
890 POKE A+128,0,0,0
900 RETURN
910 REM ---- DRAW THE PADDLE ----
920 A=V+64*228+PC
930 POKE A,63,63,63,63,63,63
940 POKE A+64,63,63,63,63,63,63
950 RETURN
960 REM ---- ERASE THE PADDLE ----
970 A=V+64*228+PC
980 POKE A,0,0,0,0,0,0
990 POKE A+64,0,0,0,0,0,0
1000 RETURN
1010 REM ---- DID THE BALL REACH THE WALL? ----
1020 IF NL<24 THEN 1090
1030 IF NL>27 THEN 1090
1040 I=INT(NC/3)
1050 IF B(I)=0 THEN 1090
1060 B(I)=0:N=N-1:S=S+1:DL=4
1070 GOSUB 860
1080 REM
1090 RETURN
