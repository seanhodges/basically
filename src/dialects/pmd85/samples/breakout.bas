10 REM BREAKOUT - K1 LEFT, K2 RIGHT. THE SCREEN IS POKED, NOT PRINTED.
20 GCLEAR
30 PRINT
40 PRINT TAB(16);"B R E A K O U T"
50 PRINT
60 PRINT TAB(9);"K1 MOVES LEFT, K2 MOVES RIGHT"
70 PRINT TAB(9);"PRESS ANY FUNCTION KEY TO START"
80 IF INKEY=255 THEN 80
90 GCLEAR
100 REM ---- VIDEO RAM IS 'C000 + 64*SCANLINE + COLUMN, SIX PIXELS TO A BYTE ----
110 V='C000
120 DIM B(15)
130 N=16
140 S=0
150 FOR I=0 TO 15
160 B(I)=1
170 GOSUB 800
180 NEXT I
190 PC=21
200 BC=24
210 BL=120
220 DC=1
230 DL=-4
240 GOSUB 920
250 GOSUB 700
260 GOSUB 1100
270 REM ---- ONE FRAME: READ THE PADDLE KEYS, THEN STEP THE BALL ----
280 K=INKEY
290 IF K<1 THEN 350
300 IF K>2 THEN 350
310 GOSUB 970
320 IF K=1 THEN PC=PC-2
330 IF K=2 THEN PC=PC+2
340 GOSUB 1140
350 GOSUB 920
360 GOSUB 750
370 NC=BC+DC
380 NL=BL+DL
390 IF NC<0 THEN GOSUB 1170
400 IF NC>47 THEN GOSUB 1170
410 IF NC<0 THEN NC=0
420 IF NC>47 THEN NC=47
430 IF NL<8 THEN DL=4
440 IF NL<8 THEN BEEP
450 IF NL<8 THEN NL=8
460 IF NL<32 THEN GOSUB 1020
470 IF NL<224 THEN 520
480 IF NC<PC THEN 520
490 IF NC>PC+5 THEN 520
500 DL=-4
510 BEEP
520 BC=NC
530 BL=NL
540 GOSUB 700
550 IF N=0 THEN 590
560 IF BL<232 THEN 280
570 REM ---- OVER, ONE WAY OR THE OTHER ----
580 REM
590 GCLEAR
600 PRINT
610 PRINT "SCORE";S
620 IF N=0 THEN PRINT "YOU CLEARED THE WALL!"
630 IF N>0 THEN PRINT "BALL LOST."
640 BEEP
650 END
660 REM
670 REM
680 REM
690 REM ---- DRAW THE BALL ----
700 A=V+64*BL+BC
710 POKE A,63
720 POKE A+64,63
730 RETURN
740 REM ---- ERASE THE BALL ----
750 A=V+64*BL+BC
760 POKE A,0
770 POKE A+64,0
780 RETURN
790 REM ---- DRAW BRICK I: THREE COLUMNS ON SCANLINES 24 TO 26 ----
800 A=V+64*24+I*3
810 POKE A,63,63,62
820 POKE A+64,63,63,62
830 POKE A+128,63,63,62
840 RETURN
850 REM ---- ERASE BRICK I ----
860 A=V+64*24+I*3
870 POKE A,0,0,0
880 POKE A+64,0,0,0
890 POKE A+128,0,0,0
900 RETURN
910 REM ---- DRAW THE PADDLE ----
920 A=V+64*228+PC
930 POKE A,63,63,63,63,63,63
940 POKE A+64,63,63,63,63,63,63
950 RETURN
960 REM ---- ERASE THE PADDLE ----
970 A=V+64*228+PC
980 POKE A,0,0,0,0,0,0
990 POKE A+64,0,0,0,0,0,0
1000 RETURN
1010 REM ---- DID THE BALL REACH THE WALL? ----
1020 IF NL<24 THEN 1090
1030 IF NL>27 THEN 1090
1040 I=INT(NC/3)
1050 IF B(I)=0 THEN 1090
1060 B(I)=0:N=N-1:S=S+1:DL=4
1070 BEEP:GOSUB 1100
1080 GOSUB 860
1090 RETURN
1100 REM ---- THE DIALOGUE LINE IS THE ONE PLACE TEXT DOES NOT TOUCH THE PLAY ----
1110 DISP "SCORE";S;"  BRICKS";N
1120 RETURN
1130 REM ---- KEEP THE PADDLE INSIDE THE 48 COLUMNS IT IS POKED INTO ----
1140 IF PC<0 THEN PC=0
1150 IF PC>41 THEN PC=41
1160 RETURN
1170 REM ---- A SIDE WALL: TURN THE BALL ROUND AND SOUND IT ----
1180 DC=-DC
1190 BEEP
1200 RETURN
