10 REM NEAL-PITTEWAY CIRCLES
20 REM X=X-E/2*Y: Y=Y+E*X: X=X-E/2*Y
30 BORDER 0: PAPER 0: INK 5: CLS
40 LET E=1/16
50 FOR R=16 TO 80 STEP 16
60 INK R/16+1
70 LET X=R: LET Y=0
80 LET PX=128+R: LET PY=88: PLOT PX,PY
90 FOR A=1 TO 105
100 LET X=X-E/2*Y
110 LET Y=Y+E*X
120 LET X=X-E/2*Y
130 LET NX=128+INT (X): LET NY=88+INT (Y)
140 DRAW NX-PX,NY-PY
150 LET PX=NX: LET PY=NY
160 NEXT A
170 NEXT R
180 PAUSE 500
190 GOTO 30
